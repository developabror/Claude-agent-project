# Copy to .env (gitignored) for local docker compose. Never commit real secrets.
# Used by compose.yaml (root), backend/compose.yaml, and frontend/compose.yaml.

# --- Postgres ---
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-local

# --- Backend ---
SPRING_PROFILES_ACTIVE=local
# For a real IdP locally, point at it; leave blank to use the dev profile's settings:
# OIDC_ISSUER_URI=http://localhost:8081/realms/app

# --- Frontend ---
# In the full stack, nginx proxies /api → backend (no value needed).
# In the frontend-only stack, the UI talks to the Prism mock via the compose network.
